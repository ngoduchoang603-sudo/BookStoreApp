@model IEnumerable<BookStoreApp.Models.Book>
@{
    ViewBag.Title = "Trang chủ - Nhà Sách Tri Thức";
}

<!-- Hero Banner Carousel -->
<div class="row mb-5">
    <div class="col-12">
        <div id="heroCarousel" class="carousel slide shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active bg-primary text-white p-5 text-center" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%); min-height: 220px;">
                    <div class="py-4">
                        <h1 class="fw-extrabold display-5">TUẦN LỄ ĐỌC SÁCH - GIẢM TỚI 50%</h1>
                        <p class="fs-5 opacity-75">Hàng ngàn đầu sách hot nhất đang chờ bạn khám phá</p>
                        <a href="#book-list" class="btn btn-light btn-lg rounded-pill px-4 fw-bold text-primary mt-2">Khám phá ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row" id="book-list">
    <!-- Sidebar Danh mục -->
    <div class="col-lg-3 mb-4">
        <div class="card border-0 shadow-sm rounded-4 sticky-lg-top" style="top: 90px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-list text-primary me-2"></i>Danh Mục Sách</h5>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Index", "Home")" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 fw-semibold">
                        <i class="fa-solid fa-border-all me-2 text-secondary"></i> Tất cả sách
                    </a>
                    @foreach (var cat in ViewBag.Categories as List<BookStoreApp.Models.Category>)
                    {
                        <a href="@Url.Action("Index", "Home", new { categoryId = cat.CategoryID })" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 text-secondary">
                            <i class="fa-solid fa-angle-right me-2 small"></i> @cat.CategoryName
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Grid Danh sách sách -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold text-dark m-0">Sách Nổi Bật</h4>
            <span class="text-muted small">Hiển thị <strong>@Model.Count()</strong> sản phẩm</span>
        </div>

        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-4">
                    <div class="card card-book h-100 shadow-sm position-relative overflow-hidden">
                        <span class="badge bg-danger position-absolute top-0 start-0 m-3 z-1 py-2 px-3 rounded-pill">-20%</span>
                        <div class="text-center p-3 bg-light">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/200x260" : item.ImageUrl)" class="img-fluid rounded" style="height: 200px; object-fit: contain;" alt="@item.Title" />
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <span class="text-muted small mb-1">@(item.Category != null ? item.Category.CategoryName : "Sách")</span>
                            <h6 class="card-title fw-bold text-dark text-truncate mb-1" title="@item.Title">@item.Title</h6>
                            <p class="text-muted small mb-2">@item.Author</p>

                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-danger fw-bold fs-6">@item.Price.ToString("N0") đ</div>
                                </div>
                                <a href="@Url.Action("AddToCart", "Cart", new { id = item.BookID })" class="btn btn-primary btn-sm rounded-circle" style="width: 36px; height: 36px; line-height: 24px;" title="Thêm vào giỏ">
                                    <i class="fa-solid fa-plus"></i>
                                </a>
                            </div>
                        </div>
                        <a href="@Url.Action("Details", "Home", new { id = item.BookID })" class="stretched-link"></a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>