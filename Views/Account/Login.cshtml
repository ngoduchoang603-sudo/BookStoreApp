@{
    ViewBag.Title = "Đăng nhập";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="text-center mb-4 text-primary font-weight-bold">Đăng nhập hệ thống</h3>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2" role="alert">
                        @ViewBag.Error
                    </div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold">Địa chỉ Email</label>
                        <input type="email" name="email" class="form-control" placeholder="Nhập địa chỉ email" required />
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label font-weight-bold">Mật khẩu</label>
                        <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu" required />
                    </div>

                    <button type="submit" class="btn btn-primary btn-block w-100 py-2 font-weight-bold">Đăng nhập</button>
                }

                <hr class="my-4" />
                <div class="text-center">
                    <span class="text-muted">Chưa có tài khoản?</span>
                    <a href="@Url.Action("Register", "Account")" class="text-primary font-weight-bold ms-1">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>