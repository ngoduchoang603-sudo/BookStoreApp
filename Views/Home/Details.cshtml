@model BookStoreApp.Models.Book
@{
    ViewBag.Title = Model.Title;
}

<div class="row my-4">
    <div class="col-md-4">
        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/300x400" : Model.ImageUrl)" class="img-fluid rounded shadow" alt="@Model.Title" />
    </div>
    <div class="col-md-8">
        <h2>@Model.Title</h2>
        <p class="text-muted">Tác giả: <strong>@Model.Author</strong></p>
        <p class="text-muted">Thể loại: <strong>@(Model.Category != null ? Model.Category.CategoryName : "Khác")</strong></p>
        <h3 class="text-danger my-3">@Model.Price.ToString("N0") VNĐ</h3>
        <p>@Model.Description</p>

        <!-- Cụm 2 nút bấm cạnh nhau -->
        <div class="d-flex gap-2 mt-4">
            <a href="@Url.Action("AddToCart", "Cart", new { id = Model.BookID })" class="btn btn-outline-success btn-lg">
                <i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ hàng
            </a>
            <a href="@Url.Action("BuyNow", "Cart", new { id = Model.BookID })" class="btn btn-danger btn-lg px-4 fw-bold">
                <i class="fa-solid fa-bolt me-1"></i> Mua ngay
            </a>
        </div>
    </div>
</div>