<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - BookStore Nhà Sách Tri Thức</title>
    <!-- Bootstrap 5 & FontAwesome Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-color: #0d6efd;
            --accent-color: #ff6b6b;
        }

        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .top-header {
            background: #1e293b;
            color: #cbd5e1;
            font-size: 0.875rem;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.6rem;
            color: #0f172a !important;
            letter-spacing: -0.5px;
        }

        .card-book {
            border: none;
            border-radius: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .card-book:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            }

        .badge-cart {
            position: absolute;
            top: -5px;
            right: -5px;
            font-size: 0.7rem;
        }

        .footer-main {
            background: #0f172a;
            color: #94a3b8;
            margin-top: 5rem;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Bar -->
    <div class="top-header py-1">
        <div class="container d-flex justify-content-between align-items-center">
            <span><i class="fa-solid fa-phone me-2 text-warning"></i>Hotline: 1900 1234 (8:00 - 21:00)</span>
            <div>
                <a href="#" class="text-light me-3 text-decoration-none small"><i class="fa-solid fa-truck me-1"></i>Tra cứu đơn hàng</a>
                <a href="#" class="text-light text-decoration-none small"><i class="fa-solid fa-circle-question me-1"></i>Trợ giúp</a>
            </div>
        </div>
    </div>

    <!-- Main Header -->
    <header class="bg-white border-bottom sticky-top shadow-sm">
        <div class="container py-3">
            <div class="row align-items-center">
                <div class="col-lg-3 col-6">
                    <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                        <i class="fa-solid fa-book-open-reader text-primary me-2"></i>Book<span class="text-primary">Store</span>
                    </a>
                </div>

                <!-- Thanh tìm kiếm chính -->
                <div class="col-lg-6 d-none d-lg-block">
                    <form method="get" action="@Url.Action("Index", "Home")" class="input-group">
                        <input type="text" name="searchString" class="form-control form-control-lg border-2 border-primary" placeholder="Tìm tên sách, tác giả, ISBN..." style="font-size: 0.95rem;">
                        <button class="btn btn-primary px-4" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                    </form>
                </div>

                <!-- Tài khoản & Giỏ hàng -->
                <div class="col-lg-3 col-6 text-end d-flex justify-content-end align-items-center gap-3">
                    @{
                        var cart = Session["Cart"] as System.Collections.Generic.List<BookStoreApp.Models.CartItem>;
                        int cartCount = cart != null ? cart.Sum(i => i.Quantity) : 0;
                    }
                    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-primary position-relative rounded-pill px-3">
                        <i class="fa-solid fa-cart-shopping me-1"></i> Giỏ hàng
                        @if (cartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@cartCount</span>
                        }
                    </a>

                    @if (Session["User"] != null)
                    {
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle rounded-pill border fw-semibold" type="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-circle-user text-primary me-1"></i> @Session["UserName"]
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li><a class="dropdown-item py-2" href="@Url.Action("OrderHistory", "Account")"><i class="fa-solid fa-boxes-packing me-2 text-secondary"></i>Đơn hàng của tôi</a></li>
                                @if (Session["Role"]?.ToString() == "Admin")
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-primary fw-bold" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"><i class="fa-solid fa-user-shield me-2"></i>Trang Quản Trị</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Account")"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary rounded-pill px-4 fw-semibold">Đăng nhập</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Content -->
    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-main py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-book-open-reader me-2 text-primary"></i>BookStore</h5>
                    <p class="small">Hệ thống cung cấp hàng ngàn đầu sách chính hãng từ các nhà xuất bản uy tín trong và ngoài nước.</p>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="text-white mb-3">Danh Mục</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Văn học</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Kinh tế - Kỹ năng</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Công nghệ thông tin</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-6">
                    <h6 class="text-white mb-3">Hỗ Trợ Khách Hàng</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Chính sách đổi trả</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Hướng dẫn đặt hàng</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Phương thức thanh toán</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6 class="text-white mb-3">Kết Nối Với Chúng Tôi</h6>
                    <div class="d-flex gap-3 mb-3">
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle"><i class="fa-brands fa-youtube"></i></a>
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle"><i class="fa-brands fa-tiktok"></i></a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center small">© 2026 BookStore. All rights reserved.</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>