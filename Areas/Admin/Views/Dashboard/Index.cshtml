@model IEnumerable<BookStoreApp.Models.Order>
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">Báo Cáo Tổng Quan</h3>
    <span class="text-muted small">Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
</div>

<!-- Cards Thống kê -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success me-3">
                    <i class="fa-solid fa-sack-dollar fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold">DOANH THU</span>
                    <h5 class="fw-bold mb-0 text-dark">@string.Format("{0:N0} đ", ViewBag.TotalRevenue ?? 0)</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary me-3">
                    <i class="fa-solid fa-cart-flatbed fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold">ĐƠN HÀNG</span>
                    <h5 class="fw-bold mb-0 text-dark">@ViewBag.TotalOrders</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning me-3">
                    <i class="fa-solid fa-book-bookmark fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold">TỔNG SỐ SÁCH</span>
                    <h5 class="fw-bold mb-0 text-dark">@ViewBag.TotalBooks</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info me-3">
                    <i class="fa-solid fa-users fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold">KHÁCH HÀNG</span>
                    <h5 class="fw-bold mb-0 text-dark">@ViewBag.TotalUsers</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng đơn hàng vừa đặt -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-4">
    <h5 class="fw-bold mb-3 text-dark">Đơn Hàng Gần Đây</h5>
    <div class="table-responsive">
        <table class="table align-middle table-hover">
            <thead class="table-light">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Ngày Đặt</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">#@item.OrderID</td>
                            <td>@(item.OrderDate.HasValue ? item.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                            <td class="fw-bold text-danger">@item.TotalAmount.ToString("N0") đ</td>
                            <td><span class="badge bg-warning text-dark px-3 py-2 rounded-pill">@item.Status</span></td>
                            <td>
                                <a href="@Url.Action("Details", "Orders", new { area = "Admin", id = item.OrderID })" class="btn btn-sm btn-outline-primary rounded-pill px-3">Chi tiết</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>