<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - BookStore Admin Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .sidebar {
            width: 260px;
            min-height: 100vh;
            background: #0f172a;
            color: #94a3b8;
        }

            .sidebar .nav-link {
                color: #94a3b8;
                padding: 0.8rem 1.2rem;
                border-radius: 8px;
                margin-bottom: 4px;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background: #1e293b;
                    color: #38bdf8;
                }

        .content-wrapper {
            flex: 1;
            padding: 2rem;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Admin Sidebar -->
        <div class="sidebar p-3 d-flex flex-column">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="d-flex align-items-center mb-4 text-white text-decoration-none fs-5 fw-bold px-2">
                <i class="fa-solid fa-sliders text-info me-2"></i> Admin Portal
            </a>
            <ul class="nav nav-pills flex-column mb-auto">
                <li>
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="nav-link">
                        <i class="fa-solid fa-chart-pie me-2"></i> Tổng quan
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Books", new { area = "Admin" })" class="nav-link">
                        <i class="fa-solid fa-book me-2"></i> Quản lý sách
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Orders", new { area = "Admin" })" class="nav-link">
                        <i class="fa-solid fa-receipt me-2"></i> Quản lý đơn hàng
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("Index", "Categories", new { area = "Admin" })" class="nav-link">
                        <i class="fa-solid fa-layer-group me-2"></i> Quản lý danh mục
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Users", new { area = "Admin" })" class="nav-link">
                        <i class="fa-solid fa-users me-2"></i> Quản lý người dùng
                    </a>
                </li>
            </ul>
            <hr class="border-secondary">
            <div class="px-2">
                <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-outline-light w-100 btn-sm mb-2"><i class="fa-solid fa-globe me-1"></i>Xem Website</a>
                <a href="@Url.Action("Logout", "Account", new { area = "" })" class="btn btn-danger w-100 btn-sm"><i class="fa-solid fa-power-off me-1"></i>Đăng xuất</a>
            </div>
        </div>


        <!-- Main Content area -->
        <div class="content-wrapper">
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>