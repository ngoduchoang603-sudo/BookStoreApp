@model BookStoreApp.Models.User
@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="text-center mb-4 text-primary font-weight-bold">Tạo tài khoản mới</h3>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2" role="alert">
                        @ViewBag.Error
                    </div>
                }

                @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold">Họ và tên</label>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", @placeholder = "Nhập họ và tên", @required = "required" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold">Địa chỉ Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @type = "email", @placeholder = "name@example.com", @required = "required" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label font-weight-bold">Mật khẩu</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Nhập mật khẩu", @required = "required" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-primary btn-block w-100 py-2 font-weight-bold">Đăng ký</button>
                }

                <hr class="my-4" />
                <div class="text-center">
                    <span class="text-muted">Đã có tài khoản?</span>
                    <a href="@Url.Action("Login", "Account")" class="text-primary font-weight-bold ms-1">Đăng nhập ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>